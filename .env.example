# Portway Environment Configuration
# Copy to .env.local and fill in values before running

# ─── Control-Plane Database ───────────────────────────────────────────────────
# Portway's own metadata DB (never share this cluster with customer databases)
DATABASE_URL="postgresql://postgres:password@localhost:5432/portway_dev"

# ─── NextAuth.js ─────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── GitHub Integration ────────────────────────────────────────────────────────
# Create at: https://github.com/settings/applications/new
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"

# ─── Cloudflare ──────────────────────────────────────────────────────────────
# Phase 1: Data-plane orchestration via Cloudflare API
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# ─── Stripe (Phase 2) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Portway <no-reply@portway.app>"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="portway.app"
NODE_ENV="development"
